PORT=9527
BIND_IP=0.0.0.0

# 外部访问 URL（用于构建完整的资源链接，例如：http://your-domain.com 或 http://192.168.1.100:9527
# 如果不配置此选项，返回的URL会是相对路径
EXTERNAL_URL=http://localhost:9527

PLAYLIST_BASE_DIR=./playlist
DAYTIME_FOLDER=daytime
NIGHT_FOLDER=night

DAYTIME_START_HOUR=6
DAYTIME_END_HOUR=22
NIGHT_START_HOUR=22
NIGHT_END_HOUR=6

CACHE_ENABLED=true
CACHE_MAX_AGE=3600

# CORS 配置
# 是否启用 CORS
CORS_ENABLED=true

# 允许的来源（逗号分隔）
# 支持通配符子域名，例如：*.xcnahida.cn
# 支持多个域名，例如：*.xcnahida.cn, *.example.com
# 允许所有来源：*
CORS_ALLOWED_ORIGINS=*.xcnahida.cn

# Test页面配置
# 是否启用测试页面
TEST_PAGE_ENABLED=false

# 歌曲排序管理页面配置
# 是否启用排序管理页面
SORT_MANAGER_ENABLED=false

# 排序管理页面访问密码（留空则自动生成随机32位密码并在启动时打印）
SORT_MANAGER_PASSWORD=
