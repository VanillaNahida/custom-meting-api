# 服务器端口
port: 9527

# 绑定 IP（0.0.0.0 表示监听所有网络接口）
bind_ip: 0.0.0.0

# 外部访问 URL（用于构建完整的资源链接）
# 例如：http://your-domain.com 或 http://192.168.1.100:9527
# 不配置则返回相对路径
external_url: http://localhost:9527

# 歌单配置
playlist:
  # 歌单根目录
  base_dir: ./playlist
  daytime:
    folder: daytime      # 日间歌单文件夹名
    start_hour: 6        # 日间开始时间（6:00）
    end_hour: 22         # 日间结束时间（22:00）
  night:
    folder: night        # 夜间歌单文件夹名
    start_hour: 22       # 夜间开始时间（22:00）
    end_hour: 6          # 夜间结束时间（6:00）

# 缓存配置
cache:
  enabled: true          # 是否启用缓存
  max_age: 3600          # 缓存最大有效时间（秒）

# CORS 配置
cors:
  enabled: true          # 是否启用 CORS
  # 允许的来源（列表形式）
  # 支持通配符子域名，例如：*.example.com
  # 允许所有来源：["*"]
  allowed_origins: "*"

# Test 页面配置
test_page:
  enabled: false         # 是否启用测试页面

# 歌曲排序管理页面配置
sort_manager:
  enabled: false         # 是否启用排序管理页面
  password: ""           # 访问密码（留空则自动生成随机密码并在启动时打印）

# FFMPEG 路径配置（用于 metadata 解析失败时的 fallback）
ffmpeg:
  ffmpeg_path: ffmpeg    # ffmpeg 路径（默认使用系统 PATH）
  ffprobe_path: ffprobe  # ffprobe 路径（默认使用系统 PATH）
