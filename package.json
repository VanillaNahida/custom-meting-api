{
  "name": "custom-meting-api",
  "version": "1.0.0",
  "description": "基于服务器时间的自定义MetingJS兼容歌单列表推送服务",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "prd": "node src/scripts/manage.js start",
    "stop": "node src/scripts/manage.js stop",
    "restart": "node src/scripts/manage.js restart",
    "status": "node src/scripts/manage.js status",
    "log": "node src/scripts/manage.js log",
    "log:f": "node src/scripts/manage.js log -f",
    "log:err": "node src/scripts/manage.js log --err",
    "monit": "node src/scripts/manage.js monit"
  },
  "keywords": [
    "music",
    "meting",
    "playlist",
    "api"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "js-yaml": "^4.2.0",
    "music-metadata": "^7.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0"
  }
}
